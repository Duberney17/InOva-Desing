# ─── Servidor ────────────────────────────────────────────
PORT=3001

# ─── Base de datos ───────────────────────────────────────
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?appName=<AppName>
# Si tu provider DNS local falla (típico en VPNs corporativas), descomenta:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=cambiame-en-produccion-por-uno-largo-aleatorio
JWT_EXPIRES_IN=7d

# ─── Supabase Storage (almacenamiento de archivos del OVA) ──
# 1. Crea cuenta gratis en https://supabase.com (no piden tarjeta)
# 2. New Project → escoge contraseña, región. Espera ~2 min a que aprovisione.
# 3. En el panel: Storage → New bucket → "ova-files" → marca "Public bucket"
# 4. Project Settings → API:
#       - Project URL                 → SUPABASE_URL
#       - Project API keys → service_role  → SUPABASE_SERVICE_KEY (¡ojo, NO la anon!)
# Guía detallada: docs/SUPABASE_STORAGE_SETUP.md
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...tu-service-role-key-larga
SUPABASE_BUCKET=ova-files
